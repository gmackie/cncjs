.page {
    min-height: calc(100vh - 50px);
    background: #f2f4f0;
    color: #21332c;
    padding: 28px;
    font-size: 15px;
    line-height: 1.55;
    h1 { font-size: 32px; margin: 8px 0; }
    h2 { font-size: 21px; margin: 0 0 12px; }
    h3 { font-size: 17px; }
    button, input, select, textarea { font: inherit; }
    button, select { min-height: 44px; padding: 8px 12px; border: 1px solid #9eafa4; border-radius: 6px; background: #fff; color: #21332c; }
    button { cursor: pointer; }
    button[aria-pressed=true] { border-color: #237b58; background: #e0f0e7; }
    button:disabled { opacity: .5; cursor: not-allowed; }
    label { display: block; margin: 10px 0; }
    input:not([type=checkbox]):not([type=range]), textarea { display: block; width: 100%; padding: 9px; border: 1px solid #9eafa4; border-radius: 5px; background: #fff; }
    textarea { min-height: 80px; }
    :focus-visible { outline: 3px solid #a66116; outline-offset: 3px; }
    fieldset { border: 0; padding: 0; min-width: 0; }
    legend { font-size: 18px; padding-top: 18px; }
    pre { max-height: 300px; overflow: auto; background: #f5f6f4; font-size: 12px; }
    code { overflow-wrap: anywhere; }
    details { margin: 16px 0; }
    summary { cursor: pointer; padding: 8px 0; }
}
.header, .toolbar { display: flex; gap: 14px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
.eyebrow { font-size: 11px; font-weight: bold; letter-spacing: 2px; color: #61746a; }
.layout { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 22px; align-items: start; }
.card { padding: 22px; background: white; border: 1px solid #d8e0d8; border-radius: 12px; margin-bottom: 18px; min-width: 0; }
.content { min-width: 0; }
.banner { background: #e1ede5; padding: 14px 18px; border-left: 4px solid #367a59; }
.error { background: #fcebe4; padding: 14px; border-left: 4px solid #ac442c; }
.muted { color: #596c60; font-size: 13px; overflow-wrap: anywhere; }
.order { display: block; width: 100%; text-align: left; margin: 12px 0; overflow-wrap: anywhere; }
.order span, .jobs small { display: block; font-size: 12px; }
.jobs { display: flex; gap: 10px; flex-wrap: wrap; }
.fields { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.metrics { display: flex; flex-wrap: wrap; gap: 24px; margin: 18px 0; }
.metrics strong { display: block; font-size: 22px; }
.plot { position: relative; background: #182a25; border-radius: 8px; overflow: hidden; }
.plot canvas { display: block; width: 100%; height: auto; }
.cursor { position: absolute; inset: 0; }
.scrubber input { width: 100%; }
.check { display: flex !important; gap: 10px; align-items: baseline; }
@media (max-width: 1100px) {
    .layout { grid-template-columns: 1fr; }
    .page { padding: 18px; }
}
@media (max-width: 600px) {
    .fields { grid-template-columns: 1fr; }
    .card { padding: 14px; }
}
.packet {
    dl > div { display: grid; grid-template-columns: minmax(110px, 1fr) minmax(0, 3fr); gap: 12px; padding: 8px 0; border-bottom: 1px solid #e5ebe5; }
    dt { text-transform: capitalize; }
    dd { margin: 0; overflow-wrap: anywhere; }
    li { padding: 5px 0; overflow-wrap: anywhere; }
}
.page select { max-width: 100%; }
