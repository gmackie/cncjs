.panel
  background #fff
  color #33432e
  border 1px solid #d4dcc8
  border-radius 10px
  padding 22px
  display flex
  flex-wrap wrap
  align-items center
  gap 14px
  font-size 12px
  strong
    font-size 15px
  p
    margin 6px 0
    color #7b8670
  form
    display flex
    flex-wrap wrap
    align-items center
    gap 10px
  button, input
    min-height 44px
    border-radius 6px
    border 1px solid #c7d0bc
    padding 8px 14px
    color #33432e
    background #fff
  button:disabled, input:disabled
    opacity .45
