.panel
  background #172b3a
  color #f4f7fa
  padding 18px
  display flex
  flex-wrap wrap
  align-items center
  gap 14px
  p
    margin 6px 0
  form
    display flex
    flex-wrap wrap
    align-items center
    gap 10px
  button, input
    min-height 44px
    border-radius 6px
    border 1px solid #708fa4
    padding 8px 14px
    color #172b3a
    background #fff
  button:disabled, input:disabled
    opacity .55
