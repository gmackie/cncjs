.shell
  --shop-ink #263331
  --shop-muted #76817b
  --shop-paper #f5f5ef
  --shop-line #dedfd6
  min-height 100vh
  display grid
  grid-template-columns 220px minmax(0,1fr)
  grid-template-rows 76px 1fr
  background var(--shop-paper)
  color var(--shop-ink)
  font-family -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif
  font-size 14px
  line-height 1.55
  h1,h2,h3,p
    margin-top 0
  h1
    font-size 36px
    letter-spacing -1.5px
    font-weight 550
    margin-bottom 0
    line-height 1.25
  h2
    font-size 21px
    letter-spacing -.5px
    font-weight 600
    margin 5px 0 10px
  h3
    font-size 16px
    margin 12px 0 8px
    font-weight 600
  a
    color inherit
    text-decoration none
  button,input,select,textarea
    font inherit
  button,select,input
    min-height 44px
    border 1px solid var(--shop-line)
    border-radius 7px
    padding 9px 13px
    background #fff
    color var(--shop-ink)
  button
    cursor pointer
    transition background .15s, border-color .15s
    &:hover:not(:disabled)
      background #f0f0e8
      border-color #acb5a9
    &:disabled
      opacity .42
      cursor not-allowed
  :focus-visible
    outline 3px solid #d37c44
    outline-offset 3px
  label
    display block
  select
    display block
    width 100%
  pre
    max-height 300px
    overflow auto
  code
    overflow-wrap anywhere
.topbar
  grid-column 1 / -1
  position sticky
  top 0
  z-index 30
  background #fff
  border-bottom 1px solid var(--shop-line)
  display flex
  align-items center
  gap 26px
  padding 0 28px
.brand
  display flex
  align-items center
  gap 12px
  font-size 15px
  font-weight 750
  letter-spacing 2px
  line-height 1.3
  small
    display block
    font-size 8px
    color #79817b
    letter-spacing 1.6px
    margin-top 4px
.brandMark
  border 2px solid #263731
  border-radius 5px
  width 38px
  height 38px
  display flex
  align-items center
  justify-content center
  font-size 21px
  letter-spacing -2px
  span
    font-size 12px
    margin 10px 0 0 1px
.topStatus
  margin-left auto
  display flex
  align-items center
  gap 9px
  color #778078
  font-size 12px
.dot,.liveDot
  width 7px
  height 7px
  border-radius 50%
  background #b8bcb0
  display inline-block
  flex-shrink 0
.liveDot
  background #4e8b65
.divider
  width 1px
  height 18px
  background var(--shop-line)
  margin 0 8px
.shell .badgeButton
  background #293d33
  color #fff
  border-color #293d33
  font-size 12px
  padding 9px 17px
  display flex
  gap 30px
  align-items center
  &:hover
    background #415b4b
.sidebar
  background #202b26
  color #abb7ae
  position sticky
  top 76px
  height calc(100vh - 76px)
  overflow-y auto
  > *
    flex-shrink 0
  padding 30px 16px 22px
  display flex
  flex-direction column
  nav a
    display flex
    align-items center
    padding 14px 12px
    margin-bottom 5px
    border-radius 6px
    gap 15px
    font-size 12px
    span
      font-family monospace
      color #788c7c
      font-size 10px
    &:hover
      color white
      background #2b3a31
  nav .current
    background #35463a
    color #f5f5ea
    span
      color #e8b77f
.navLabel,.tiny,.eyebrow
  font-size 9px
  letter-spacing 1.5px
  font-weight 600
  color #778078
.navLabel
  color #75897b
  padding 0 12px
  margin-bottom 20px
.machineIdentity
  border-top 1px solid #39463b
  margin 38px 10px 0
  padding-top 24px
  .tiny
    color #7c9181
    font-size 8px
  strong
    display block
    color #e3e8df
    margin 12px 0 8px
    font-size 15px
  p
    font-size 11px
    line-height 2
.restricted
  font-size 10px
  color #d0b38c
  display block
  margin-top 18px
.fabLink
  padding-top 24px
  margin auto 12px 0
  font-size 11px
  display flex
  justify-content space-between
.main
  min-width 0
  padding 32px 36px 0
  max-width 1780px
  width 100%
  margin 0 auto
.pageHeading,.cardHeading,.sectionTitle
  display flex
  align-items center
  justify-content space-between
  gap 16px
.pageHeading
  margin-bottom 28px
  .eyebrow
    display block
    margin-bottom 8px
.modePill,.outlineTag
  font-size 9px
  letter-spacing 1.4px
  white-space nowrap
  border 1px solid #d6d9cc
  padding 7px 10px
  border-radius 4px
  color #7b816f
.heroGrid
  display grid
  grid-template-columns minmax(0,1.5fr) minmax(0,1fr)
  gap 22px
.machineCard,.cameraCard,.queueSummary,.readiness,.panel,.workflow
  border 1px solid var(--shop-line)
  border-radius 12px
  background #fff
  overflow hidden
.machineCard
  background #edeee5
  .cardHeading
    padding 22px 24px 0
  svg
    display block
    width 100%
    height 270px
  h2
    margin-bottom 0
.machineCaption
  display flex
  justify-content space-between
  padding 15px 24px
  font-size 10px
  gap 10px
  border-top 1px solid #dcdfd2
  color #828777
  span:last-child
    font-size 8px
    letter-spacing 1px
.cameraCard
  display flex
  flex-direction column
  .cardHeading
    padding 22px 22px 12px
    h2
      margin-bottom 0
    button
      border 0
      padding 0
      font-size 11px
.cameraViewport
  flex 1
  min-height 225px
  margin 0 14px
  border-radius 6px
  background #202b29
  color #ccd4c9
  display flex
  align-items center
  justify-content center
  text-align center
  img
    display block
    width 100%
    max-height 290px
    object-fit contain
  > div
    max-width 220px
    padding 15px
  strong
    display block
    font-size 13px
    font-weight 500
  p
    color #81948a
    font-size 11px
    margin 8px 0
.cameraIcon
  display block
  font-size 42px
  color #768c7d
  margin-bottom 8px
.cameraFooter
  display flex
  align-items center
  justify-content space-between
  padding 17px 20px
  font-size 9px
  color #828b81
  gap 10px
  i
    margin-right 6px
  > span:last-child
    letter-spacing 1px
.telemetry
  display grid
  grid-template-columns 1.3fr repeat(3,1fr)
  margin 24px 0 30px
  padding 22px 0
  border-top 1px solid var(--shop-line)
  border-bottom 1px solid var(--shop-line)
  > div
    border-right 1px solid var(--shop-line)
    padding 0 22px
    &:first-child
      padding-left 0
    &:last-child
      border-right 0
  strong
    display block
    font-size 21px
    font-weight 500
    margin 5px 0
  small
    color #909589
    font-size 10px
  .coordinate
    font-family 'SFMono-Regular', Consolas, monospace
    small
      margin-left 8px
      font-family inherit
.bottomGrid
  display grid
  grid-template-columns minmax(0,1.5fr) minmax(0,1fr)
  gap 22px
.queueSummary,.readiness,.panel
  padding 24px
.sectionTitle
  h2
    margin-bottom 0
  > a
    font-size 11px
    white-space nowrap
.count
  font-size 10px
  background #eeeee5
  display inline-flex
  align-items center
  justify-content center
  width 22px
  height 22px
  border-radius 50%
  vertical-align middle
  margin-left 6px
.emptyQueue
  display flex
  align-items center
  gap 20px
  padding 30px 0 15px
  > span
    color #9fa999
    font-size 34px
    padding 0 14px
  strong
    font-size 13px
    font-weight 500
  p
    font-size 11px
    color #90968c
    margin 7px 0
.queueRow
  display flex
  justify-content space-between
  gap 14px
  padding 17px 0
  border-bottom 1px solid var(--shop-line)
  small
    color #7c887a
.readiness
  background #ecefe3
  border-color #dbe0ce
  p
    font-size 12px
    color #74816a
  h2
    margin-top 14px
  > div
    display flex
    gap 20px
    margin-top 20px
    font-size 11px
.workflow
  padding 24px
.steps
  display grid
  grid-template-columns repeat(4,minmax(0,1fr))
  gap 24px
  margin-top 30px
  p
    font-size 12px
    color #798273
.stepNumber
  color #b39360
  font-family monospace
  font-size 12px
.workflowNote
  margin-top 20px
  padding-top 20px
  border-top 1px solid var(--shop-line)
  font-size 12px
  display flex
  flex-wrap wrap
  gap 10px
  span
    color #7a8472
.footer
  display flex
  align-items center
  flex-wrap wrap
  justify-content space-between
  gap 12px
  padding 26px 0 22px
  font-size 8px
  color #8d9687
  letter-spacing 1px
  > span:first-child span
    margin 0 10px
  button
    font-size 11px
    letter-spacing 0
    color #ac6a3a
    background transparent
    min-height 38px
.alert,.notice,.lockNotice
  padding 15px 20px
  border-radius 7px
  background #f6e7da
  color #905531
  font-size 12px
  margin-bottom 20px
.notice
  background #e9efdf
  color #597444
.lockNotice
  background #e9ebdf
  color #707e5f
  display flex
  gap 12px
  flex-wrap wrap
.access
  margin-bottom 24px
.controlsGrid
  display grid
  grid-template-columns repeat(2,minmax(0,1fr))
  gap 22px
  p
    font-size 12px
    color #788471
  label
    font-size 11px
    color #75816d
.actions
  display flex
  flex-wrap wrap
  gap 8px
  margin 16px 0
.shell .primary
  background #2d4735
  color #fff
  border-color #2d4735
.fields
  display grid
  grid-template-columns repeat(2,minmax(0,1fr))
  gap 14px
.jogGrid
  display grid
  grid-template-columns repeat(2,1fr)
  gap 8px
  margin 16px 0
  button
    font-family monospace
    font-size 20px
.subtle
  font-size 11px
  color #829079
.macroRow
  display flex
  justify-content space-between
  gap 12px
  width 100%
  text-align left
  margin-top 10px
.confirm
  position fixed
  z-index 50
  top 50%
  left 50%
  transform translate(-50%,-50%)
  width 560px
  max-width calc(100vw - 40px)
  max-height 85vh
  overflow auto
  padding 28px
  background #fff
  border 2px solid #919e80
  border-radius 12px
  box-shadow 0 20px 70px #14251a55
.check
  display flex !important
  gap 12px
  align-items center
@media (min-width: 1650px)
  .machineCard svg
    height 330px
@media (max-width: 1150px)
  .shell
    grid-template-columns 180px minmax(0,1fr)
  .main
    padding 24px 24px 0
  .steps
    grid-template-columns repeat(2,minmax(0,1fr))
  .heroGrid,.bottomGrid
    grid-template-columns 1fr
  .cameraViewport
    min-height 210px
  .cameraCard
    .cardHeading
      padding-top 16px
@media (max-width: 850px)
  .shell
    display block
  .topbar
    height 76px
    padding 0 20px
  .topStatus
    display none
  .badgeButton
    margin-left auto
  .sidebar
    position sticky
    top 76px
    z-index 20
    height auto
    padding 8px 12px
    nav
      display flex
      overflow-x auto
      a
        white-space nowrap
        min-height 44px
        margin 0 4px 0 0
        font-size 11px
        padding 10px
        span
          display none
  .navLabel,.machineIdentity,.fabLink
    display none
  .heroGrid
    grid-template-columns 1.2fr 1fr
  .machineCard svg
    height 240px
  .machineCaption
    > span:last-child
      display none
@media (max-width: 620px)
  .main
    padding 24px 16px 0
  .shell h1
    font-size 27px
  .heroGrid,.controlsGrid,.bottomGrid
    grid-template-columns 1fr
  .telemetry
    grid-template-columns repeat(2,1fr)
    gap 18px 0
    > div
      padding 0 14px
      &:nth-child(odd)
        padding-left 0
      &:nth-child(even)
        border 0
  .pageHeading
    gap 10px
  .modePill
    font-size 8px
  .steps
    grid-template-columns 1fr
    gap 12px
  .brand
    font-size 12px
    small
      font-size 7px
  .brandMark
    width 32px
    height 32px
  .shell .badgeButton
    gap 12px

.laserParameters
  display grid
  grid-template-columns repeat(3,minmax(0,1fr))
  border-top 1px solid var(--shop-line)
  padding-top 20px
  margin-top 20px
  gap 16px
  span,small
    display block
    color #839078
    font-size 11px
  strong
    display block
    font-family monospace
    font-size 22px
    font-weight 500
    margin 5px 0

.dialogLayer
  position fixed
  inset 0
  z-index 50
  background #14251ac9

.skipLink
  position fixed
  left 16px
  top -80px
  z-index 100
  padding 14px 20px
  background #fff
  border 2px solid #293d33
  border-radius 6px
  &:focus
    top 12px
.applianceStatus
  display grid
  grid-template-columns repeat(3,minmax(0,1fr))
  gap 20px
  padding 18px 22px
  margin-bottom 24px
  background #e9ede5
  border 1px solid #d8dfd1
  border-radius 10px
  > div
    min-width 0
  .tiny,strong,small
    display block
  strong
    font-size 13px
    font-weight 600
    margin-top 5px
    overflow-wrap anywhere
  small
    font-size 11px
    color #58665a
    margin-top 3px
  i
    margin-right 7px
.cameraHint
  font-size 11px
  color #606f63
  margin 0
  padding 0 20px 18px
.cameraCard .cardHeading button
  min-width 88px
  padding 8px
.cameraViewport
  position relative
.cameraFooter
  color #59685d
.shell
  --shop-muted #58675d
  .tiny,.eyebrow
    color #606e62
  .subtle
    color #61705a
@media (max-width: 620px)
  .applianceStatus
    grid-template-columns 1fr
    gap 12px
    padding 16px
    > div + div
      border-top 1px solid #d0d9c8
      padding-top 12px
  .cameraCard .cardHeading
    gap 8px
@media (prefers-reduced-motion: reduce)
  .shell button
    transition none

.guideLink
  display inline-flex
  align-items center
  min-height 48px
  padding 12px 18px
  border 1px solid #b7c6b1
  border-radius 7px
  background #edf2e8
  font-weight 600

.setupGrid
  display grid
  grid-template-columns minmax(0, 1.2fr) minmax(0, 1fr)
  align-items start
  gap 24px
  margin 24px 0
.setupMonitor
  display grid
  gap 20px
.setupSteps
  display grid
  gap 8px
  margin 20px 0
  button
    display flex
    gap 12px
    align-items center
    text-align left
    min-height 44px
    &[aria-current="step"]
      background #e4eddc
      border-color #45663f
      font-weight 600
    span
      color #566c4d
.setupInstruction
  border-top 1px solid #d8dfd1
  padding-top 22px
  min-height 190px
  p
    line-height 1.8
.setupCoordinates
  width 100%
  margin 18px 0
  font-variant-numeric tabular-nums
  caption
    text-align left
    color #56634f
    margin-bottom 10px
  th,td
    padding 8px
    border-bottom 1px solid #d8dfd1
    text-align right
  th:first-child
    text-align left
.setupControls
  margin 28px 0
.setupHandbook
  width 100%
  height 700px
  border 1px solid #d8dfd1
  border-radius 8px
  background white
@media (max-width: 1100px)
  .setupGrid
    grid-template-columns minmax(0, 1fr)
  .setupInstruction
    min-height 0
