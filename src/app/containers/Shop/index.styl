.shop {
    background: #f4f5f2;
    color: #202c28;
    min-height: calc(100vh - 50px);
    padding: 36px 40px 20px;
    font-family: 'Helvetica Neue', Arial, sans-serif;
    font-size: 15px;
    line-height: 1.6;
    h1 {
        font-size: 42px;
        letter-spacing: -1.5px;
        font-weight: 700;
        margin: 8px 0;
    }
    h1 span {
        color: #728179;
        font-weight: 400;
    }
    h2 {
        font-size: 20px;
        font-weight: 600;
        margin: 0 0 8px;
    }
    h3 {
        font-size: 18px;
    }
    button, a {
        touch-action: manipulation;
    }
    button:focus-visible, a:focus-visible, input:focus-visible {
        outline: 3px solid #bd6d26;
        outline-offset: 3px;
    }
    button:disabled {
        opacity: .45;
        cursor: not-allowed;
    }
}
.hero, .section-heading, .footer, .actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}
.hero {
    margin-bottom: 28px;
}
.eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #637269;
}
.primary, .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    min-height: 48px;
    padding: 10px 18px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid #cdd5cf;
    cursor: pointer;
    white-space: nowrap;
    &:hover, &:focus {
        text-decoration: none;
    }
}
.primary {
    background: #24533f;
    color: #fff;
    border-color: #24533f;
    &:hover, &:focus {
        background: #163f2d;
        color: #fff;
    }
}
.secondary {
    background: #fff;
    color: #2b4e3d;
    &:hover, &:focus {
        background: #edf3ee;
        color: #173d29;
    }
}
.tabs {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid #d9dfd9;
    margin-bottom: 24px;
    button {
        background: transparent;
        border: 0;
        border-bottom: 3px solid transparent;
        padding: 14px 24px;
        min-height: 52px;
        color: #66726a;
        font-weight: 600;
    }
    button.active {
        color: #24533f;
        border-bottom-color: #24533f;
    }
}
.metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 24px;
    > div {
        background: #e9ede7;
        padding: 20px 24px;
        border-radius: 10px;
    }
    span {
        display: block;
        color: #627166;
        font-size: 10px;
        letter-spacing: 1.4px;
        font-weight: 700;
        margin-bottom: 10px;
    }
    strong {
        display: block;
        font-size: 22px;
        font-weight: 500;
    }
    small {
        display: block;
        color: #59685f;
        margin-top: 4px;
    }
}
.online, .offline {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    margin: 0 10px 2px 0;
}
.online {
    background: #247749;
}
.offline {
    background: #a47634;
}
.columns {
    display: grid;
    grid-template-columns: minmax(280px, .85fr) minmax(360px, 1.4fr);
    gap: 24px;
}
.panel {
    background: #fff;
    border: 1px solid #dfe4dc;
    border-radius: 12px;
    padding: 26px;
    margin-bottom: 24px;
}
.section-heading {
    align-items: flex-start;
    margin-bottom: 18px;
}
.tag {
    border: 1px solid #d9dfd7;
    color: #64705f;
    border-radius: 5px;
    padding: 4px 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    white-space: nowrap;
}
.coordinates {
    margin: 22px 0;
    > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #eef0eb;
        padding: 10px 0;
    }
    span {
        font-size: 16px;
        color: #667967;
    }
    strong {
        font-family: Menlo, Consolas, monospace;
        font-size: 32px;
        font-weight: 400;
        font-variant-numeric: tabular-nums;
    }
}
.muted {
    color: #647166;
    font-size: 13px;
}
.steps {
    padding-left: 24px;
    margin: 4px 0 18px;
    li {
        padding: 0 0 16px 8px;
    }
    li::marker {
        color: #477352;
        font-weight: 700;
    }
}
.macro-list > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 18px 0;
    border-top: 1px solid #e8ece5;
    small {
        display: block;
        color: #647166;
        margin-top: 4px;
    }
}
.review {
    background: #f4f6f0;
    border: 1px solid #d7dfce;
    padding: 22px;
    border-radius: 8px;
    margin-top: 20px;
    textarea {
        width: 100%;
        max-height: 260px;
        overflow: auto;
        font-family: monospace;
        padding: 12px;
        border: 1px solid #cdd5cf;
    }
    label {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        font-weight: 400;
        padding: 12px 0;
    }
    input {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
    }
}
.actions {
    justify-content: flex-end;
}
.laser-settings {
    display: flex;
    gap: 40px;
    padding: 0 0 22px;
    span {
        display: block;
        color: #647166;
    }
    strong {
        font-size: 24px;
    }
}
.error, .notice {
    padding: 18px;
    border-radius: 8px;
}
.error {
    background: #fae9e4;
    color: #873b26;
}
.notice {
    background: #e5efdf;
    color: #305628;
}
.footer {
    color: #758075;
    font-size: 10px;
    letter-spacing: 1px;
    padding: 8px 0;
}
@media (max-width: 1100px) {
    .shop {
        padding: 24px;
    }
    .columns {
        grid-template-columns: 1fr;
    }
    .metrics {
        gap: 12px;
        > div {
            padding: 16px;
        }
    }
}
@media (max-width: 700px) {
    .shop {
        padding: 18px 14px;
        h1 {
            font-size: 34px;
        }
    }
    .hero {
        align-items: flex-start;
        flex-direction: column;
    }
    .metrics {
        grid-template-columns: 1fr;
    }
    .tabs {
        gap: 0;
        button {
            padding: 12px;
            flex: 1;
        }
    }
    .panel {
        padding: 18px;
    }
    .macro-list > div {
        align-items: flex-start;
        flex-direction: column;
    }
    .section-heading {
        flex-wrap: wrap;
    }
    .footer {
        flex-direction: column;
        align-items: flex-start;
    }
}
