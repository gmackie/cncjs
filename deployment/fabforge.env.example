FABFORGE_URL=https://fab.forgegraf.com
# UUID from the FabForge workspace record, not the account username.
FABFORGE_WORKSPACE_ID=
# Mint a dedicated workspace token with read,write scopes. Keep this file private.
FABFORGE_TOKEN=
# Optional: only allow reviews/actions for jobs assigned to this resource UUID.
FABFORGE_RESOURCE_ID=

# Default is viewer/badge access. Set 0 only for administrator maintenance.
CNCJS_BADGE_ACCESS=1

# Enable only after FabForge machine-usage API and database migration are deployed.
CNCJS_USAGE_SYNC=0
